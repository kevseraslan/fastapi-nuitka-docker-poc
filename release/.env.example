# ==================================================================
# FastAPI + Nuitka + Docker PoC Environment Variables (.env.example)
# ==================================================================
# Bu dosyayı kopyalayarak '.env' adında bir dosya oluşturun ve
# değerleri kendi ortamınıza göre güncelleyin.
# Gerçek .env dosyasını kesinlikle versiyon kontrolüne (Git) eklemeyin.

# ------------------------------------------------------------------
# Host Port Eşlemeleri (Docker Compose)
# ------------------------------------------------------------------
HOST_APP_PORT=8000
HOST_DB_PORT=5433

# ------------------------------------------------------------------
# Veritabanı Yapılandırması (PostgreSQL)
# ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=py_fast_api_test

# ------------------------------------------------------------------
# JWT Güvenlik Yapılandırması
# ------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production
JWT_ISSUER=auth-service

# ------------------------------------------------------------------
# Sunucu & Uygulama Ayarları
# ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
APP_NAME=FastAPI Nuitka PoC
ENVIRONMENT=production
ACCESS_EXPIRE_MIN=15
REFRESH_EXPIRE_DAYS=7
